@model IEnumerable<CartVM>
@{
    ViewData["Title"] = "Кошик";
}

<main class="bg-light min-vh-100 py-5">

    <div class="container">

        <!-- Заголовок -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div class="d-flex align-items-center gap-3">

                <i class="bi bi-cart3 display-3"></i>

                <div>
                    <h1 class="display-4 fw-bold mb-0">
                        Кошик
                    </h1>

                    <p class="text-secondary fs-5 mb-0">
                        Перевірте обрані товари та оформіть замовлення
                    </p>
                </div>

            </div>

            <a href="#"
               class="btn btn-outline-primary d-none d-md-inline-flex align-items-center gap-2">

                <i class="bi bi-arrow-left"></i>

                Продовжити покупки

            </a>

        </div>


        <div class="row g-4">

            <!-- Кошик -->

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4">

                        <!-- Header -->

                        <div class="row border-bottom pb-3 text-secondary fw-semibold d-none d-md-flex">

                            <div class="col-md-5">
                                Товар
                            </div>

                            <div class="col-md-2 text-center">
                                Ціна
                            </div>

                            <div class="col-md-2 text-center">
                                Кількість
                            </div>

                            <div class="col-md-2 text-center">
                                Сума
                            </div>

                        </div>


                        <!-- Products -->
                        @foreach (var item in Model)
                        {                            
                            <div class="row align-items-center py-4 border-bottom gy-3">

                                <div class="col-md-5">

                                    <div class="d-flex align-items-center gap-3">

                                        <img src="~/images/products/@(item.Product!.Image != null ? item.Product!.Image : "default.jpg")"
                                             class="rounded-3 bg-light p-2"
                                             width="100"
                                             height="100"
                                             alt="RTX 4070">

                                        <div>

                                            <a href="#"
                                               class="text-dark text-decoration-none fw-bold">
                                                @item.Product!.Name
                                            </a>

                                            <div class="text-secondary small mt-1">
                                                @item.Product!.Category!.Name
                                            </div>

                                            <div class="text-success small fw-semibold mt-2">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                В наявності
                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <div class="col-6 col-md-2 text-md-center">

                                    <span class="fw-semibold">
                                        @item.Product.Price ₴
                                    </span>

                                </div>


                                <div class="col-6 col-md-2">

                                    <div class="input-group input-group-sm">

                                        <button class="btn btn-outline-secondary">
                                            <i class="bi bi-dash"></i>
                                        </button>

                                        <input type="text"
                                               value="@item.Count"
                                               class="form-control text-center"
                                               readonly>

                                        <button class="btn btn-outline-secondary">
                                            <i class="bi bi-plus"></i>
                                        </button>

                                    </div>

                                </div>


                                <div class="col-10 col-md-2 text-md-center">

                                    <span class="fw-bold">
                                        @(item.Product!.Price * item.Count) ₴
                                    </span>

                                </div>


                                <div class="col-1 col-md-1 text-end">

                                    <a asp-controller="Cart" asp-action="Remove" asp-route-productId="@item.Product.Id" class="btn btn-link text-secondary p-0">
                                        <i class="bi bi-x-lg fs-5"></i>
                                    </a>

                                </div>

                            </div>
                        }

                        <!-- Clear cart -->

                        <div class="pt-3">

                            <a asp-action="Clear" asp-controller="Cart" class="btn btn-link text-primary text-decoration-none p-0">

                                <i class="bi bi-trash me-2"></i>

                                Очистити кошик

                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Summary -->

            <div class="col-lg-4">

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4">

                        <h3 class="fw-bold mb-4">
                            Підсумок замовлення
                        </h3>


                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-secondary">
                                Товарів (4)
                            </span>

                            <strong>
                                60 796 ₴
                            </strong>

                        </div>


                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-secondary">
                                Знижка
                            </span>

                            <strong class="text-success">
                                − 2 500 ₴
                            </strong>

                        </div>


                        <div class="d-flex justify-content-between mb-4">

                            <span class="text-secondary">
                                Доставка
                            </span>

                            <strong class="text-success">
                                Безкоштовно
                            </strong>

                        </div>


                        <hr>


                        <div class="d-flex justify-content-between align-items-center my-4">

                            <span class="fs-5 fw-bold">
                                Разом
                            </span>

                            <span class="fs-3 fw-bold">
                                58 296 ₴
                            </span>

                        </div>


                        <button class="btn btn-primary btn-lg w-100 mb-3">

                            Оформити замовлення

                            <i class="bi bi-arrow-right ms-2"></i>

                        </button>


                        <button class="btn btn-light text-primary btn-lg w-100 mb-4">
                            Купити в 1 клік
                        </button>


                        <!-- Benefits -->

                        <div class="d-flex align-items-center gap-3 mb-4">

                            <div class="bg-primary-subtle text-primary rounded-circle p-3">
                                <i class="bi bi-truck fs-4"></i>
                            </div>

                            <div>
                                <div class="fw-semibold">
                                    Безкоштовна доставка
                                </div>

                                <small class="text-secondary">
                                    при замовленні від 2000 ₴
                                </small>
                            </div>

                        </div>


                        <div class="d-flex align-items-center gap-3 mb-4">

                            <div class="bg-primary-subtle text-primary rounded-circle p-3">
                                <i class="bi bi-shield-check fs-4"></i>
                            </div>

                            <div>
                                <div class="fw-semibold">
                                    Гарантія 12 місяців
                                </div>

                                <small class="text-secondary">
                                    на всі товари
                                </small>
                            </div>

                        </div>


                        <div class="d-flex align-items-center gap-3">

                            <div class="bg-primary-subtle text-primary rounded-circle p-3">
                                <i class="bi bi-arrow-repeat fs-4"></i>
                            </div>

                            <div>
                                <div class="fw-semibold">
                                    Повернення 14 днів
                                </div>

                                <small class="text-secondary">
                                    без зайвих питань
                                </small>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

</main>